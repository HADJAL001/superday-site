# SUPER DAY — образ для собственного кластера OSGARD (control-plane, задание 3.11).
#
# Существующие площадки не затрагиваются: GitHub Pages (superday.fun) и Netlify
# продолжают публиковать этот же репозиторий как статику. Этот Dockerfile —
# третий, независимый способ доставки того же содержимого, нужный чтобы
# замкнуть контур «git → прод» на своей инфраструктуре вместо Vercel.
#
# Сайт — чистая статика без шага сборки (package.json отсутствует), поэтому
# multi-stage не нужен: копируем как есть в nginx. Единственное, что образ
# добавляет к файлам — правила кэширования и security-заголовки, которые на
# Netlify заданы в netlify.toml, а на GitHub Pages недоступны вовсе.
FROM nginx:alpine

# Конфиг кладём до контента: он меняется куда реже файлов сайта, поэтому
# отдельным слоем — пересборка при правке статики не трогает этот слой.
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/security-headers.conf /etc/nginx/snippets/security-headers.conf

# .dockerignore исключает служебное (.git, COORDINATION.md, netlify.toml) —
# в образ попадает только то, что реально отдаётся браузеру. Каталог deploy/
# исключить там нельзя (из него читает COPY выше), поэтому убираем его из
# итоговой выдачи здесь: конфиг сервера не должен быть доступен по HTTP.
COPY . /usr/share/nginx/html
RUN rm -rf /usr/share/nginx/html/deploy

# Проверка конфига на этапе сборки, а не при старте контейнера: битый конфиг
# должен валить build, а не давать образ, который упадёт уже в проде и будет
# выглядеть как отказ health-check по неизвестной причине.
RUN nginx -t

EXPOSE 80
